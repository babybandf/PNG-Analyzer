{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared settings: Ninja, vcpkg toolchain + manifest at the repository root, and a single shared vcpkg install tree reused by every preset.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/.deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_INSTALL": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development build + unit tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNGA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan/UBSan build + unit tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNGA_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNGA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "coverage-fuzz",
      "inherits": "base",
      "displayName": "Optional LLVM libFuzzer harness",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_DISABLE_FIND_PACKAGE_Qt6": "TRUE",
        "PNGA_BUILD_TESTS": "ON",
        "PNGA_BUILD_COVERAGE_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" },
    { "name": "coverage-fuzz", "configurePreset": "coverage-fuzz" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
